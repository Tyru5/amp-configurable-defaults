{
  "manifest_version": 3,
  "name": "amp better defaults",
  "version": "1.2.0",
  "description": "Move Amp's desktop navigation sidebar to the right. Click the toolbar icon to switch sides.",
  "homepage_url": "https://github.com/Tyru5/amp-sidebar-right",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Amp sidebar: switch sides",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://ampcode.com/*"],
      "css": ["sidebar.css"],
      "js": ["content.js", "subagents.js"],
      "run_at": "document_start"
    }
  ]
}
