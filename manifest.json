{
  "manifest_version": 3,
  "name": "amp configurable defaults",
  "version": "1.2.0",
  "description": "Move Amp's desktop navigation sidebar to the right and show each thread's model and runner in the composer. Click the toolbar icon to customize your settings.",
  "homepage_url": "https://github.com/Tyru5/amp-configurable-defaults",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://ampcode.com/*"],
  "action": {
    "default_title": "amp configurable defaults: open settings",
    "default_popup": "options.html?popup",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://ampcode.com/*"],
      "css": ["sidebar.css"],
      "js": ["content.js", "thread-split.js", "subagents.js", "composer.js", "info-orb.js"],
      "run_at": "document_start"
    }
  ]
}
